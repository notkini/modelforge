# ModelForge configuration (loaded from this file by backend/config.py).
# Copy to .env at the repository root and edit. Never commit .env.

# --- Sign-in & security ----------------------------------------------------------------
# Google OAuth web client ID (a public identifier), from Google Cloud Console.
# Leave empty to disable Google sign-in and use local email/password accounts only.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# REQUIRED for any sign-in. A long random secret (>= 40 chars), never committed:
#   py -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-secret
# true only when the site is served over HTTPS; keep false for local http://localhost use.
SECURE_COOKIES=false

# --- Data storage ----------------------------------------------------------------------
# SQLAlchemy URL. SQLite below is the development default (single process only).
# Production example: postgresql+psycopg://user:password@host:5432/modelforge
DATABASE_URL=sqlite:///./modelforge.db
# Private, persistent directory for mesh arrays and STEP files. It must stay
# outside anything the frontend serves statically; back it up together with the database.
ARTIFACT_DIR=./private_artifacts

# --- Networking ------------------------------------------------------------------------
# The exact browser origin of the frontend; used for the CORS allow-list and cookie policy.
FRONTEND_ORIGIN=http://localhost:5173

# --- Gemini (optional; enables the Gemini interpreter and script generation) -----------
# API key from Google AI Studio. Without it, prompts use the deterministic local
# parser and the Gemini interpreter cannot be selected.
GEMINI_API_KEY=
# Gemini model name (default: gemini-3.8-flash). Check Google's current model and
# pricing documentation before relying on a model; availability/quotas vary.
GEMINI_MODEL=gemini-3.8-flash

# --- Script sandbox limits (optional; all values are validated and clamped) -----------
# Tighten only with evidence; the defaults were tuned for ordinary models.
# Full list and meaning: SANDBOX_SECURITY.md
# MF_SANDBOX_WALL_TIMEOUT_S=90
# MF_SANDBOX_CPU_SECONDS=30
# MF_MAX_BREP_BYTES=16777216
# MF_MAX_MESH_VERTICES=400000
# MF_MAX_MESH_FACES=800000
